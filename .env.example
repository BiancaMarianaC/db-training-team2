# TradeFlow local / demo environment
# Copy this file to .env. Do not commit a real .env file.

# PostgreSQL container
POSTGRES_DB=tradeflow
POSTGRES_USER=tradeflow_user
POSTGRES_PASSWORD=changeme

# Grafana login
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Images published by GitHub Actions to GHCR.
# Use matching tags for the backend and frontend. `latest` is convenient for
# development; pin both images to the same full CI commit SHA for a stable demo.
BACKEND_IMAGE=ghcr.io/biancamarianac/tradeflow-backend:latest
FRONTEND_IMAGE=ghcr.io/biancamarianac/tradeflow-frontend:latest

# Example SHA-pinned deployment (replace <full-commit-sha> with the SHA from
# a successful GitHub Actions run):
# BACKEND_IMAGE=ghcr.io/biancamarianac/tradeflow-backend:<full-commit-sha>
# FRONTEND_IMAGE=ghcr.io/biancamarianac/tradeflow-frontend:<full-commit-sha>
