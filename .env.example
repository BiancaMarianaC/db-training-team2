# ============================================================================
# TradeFlow — sample environment variables
# ============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit a real `.env` — see .gitignore.
# ============================================================================

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=tradeflow
POSTGRES_USER=tradeflow_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Spring Boot profile --------------------------------------------------
# dev | uat | prod
SPRING_PROFILES_ACTIVE=dev

# --- Kafka ----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=recon-group
KAFKA_TRADES_TOPIC=trade-events

# --- Grafana --------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Frontend -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- docker-compose.yml image overrides (TICKET-I127 + I133) --------------
# Defaults point at GHCR (populated once I133's CI runs on a push to
# develop/main). Until then — or for a local-only demo — build the images
# locally and override here instead of rebuilding through compose:
#   docker build -t tradeflow-backend:local backend/
#   docker build -t tradeflow-frontend:local frontend/
#   BACKEND_IMAGE=tradeflow-backend:local
#   FRONTEND_IMAGE=tradeflow-frontend:local
# BACKEND_IMAGE=ghcr.io/biancamarianac/tradeflow-backend:latest
# FRONTEND_IMAGE=ghcr.io/biancamarianac/tradeflow-frontend:latest
